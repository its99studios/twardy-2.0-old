  "previewIconUrl": "https://asset-resources.gdevelop.io/public-resources/Icons/910b853cf17af2349c0d2301e6c317675207f25c7313906864b1809c0d34dabf_database-search-outline.svg",
  "shortDescription": "A numeric ID system to manage object and item data across multiple sprites.",
  "version": "2.1.0",
  "description": [
    "This extension provides a centralized database for all items in Twardy 2.0. It allows you to:",
    "",
    "* Define item properties (Name, Weight, Type, etc.) in a single Structure variable.",
    "",
    "* Use a Behavior to \"tag\" any sprite with a specific Item ID.",
    "",
    "* Automatically sync animations based on the ID.",
    "",
    "* Use Expressions to fetch data for UI, tooltips, and inventory logic without hardcoding values in every event."
  ],
  "tags": [
    "items",
    "database",
    "id system",
    "inventory",
    "structure",

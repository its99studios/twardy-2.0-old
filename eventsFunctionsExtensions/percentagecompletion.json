      "fullName": "Add percentage",
      "functionType": "Action",
      "name": "AddPercentage",
      "sentence": "Add _PARAM1_% to percentage completion",
      "events": [
        {
          "type": "BuiltinCommonInstructions::Standard",
          "conditions": [],
          "actions": [
            {
              "type": {
                "value": "SetNumberVariable"
              },
              "parameters": [
                "CurrentCompletionPoints",
                "+",
                "Percentage * 10"
              ]
